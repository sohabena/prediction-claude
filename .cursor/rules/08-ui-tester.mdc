## Critical Test Scenarios

### 1. Strategy Tests (Backend)
**File:** `tests/unit/test_strategies.py`

```python
def test_simple_odds_change_detects_significant_increase():
    """Test 2% threshold for odds increase."""
    state = MatchState(match_id="test")
    state.odds_history.append({'back_price': 2.00, 'timestamp': now})
    state.odds_history.append({'back_price': 2.05, 'timestamp': now})  # 2.5%
    
    signal = strategy.evaluate(state, {'back_price': 2.05})
    
    assert signal is not None
    assert signal.action == "BACK"  # Contrarian
    assert signal.confidence >= 0.55

def test_panic_rebound_requires_wicket():
    """Test that panic rebound needs is_wicket=True."""
    event = {'is_wicket': False, 'odds': 2.20}
    signal = strategy.evaluate(state, event)
    assert signal is None  # Should not trigger
```

### 2. Budget API Tests
```python
def test_initialize_budget_success():
    """Test budget initialization."""
    response = client.post(
        "/api/budget/initialize",
        json={"initial_amount": 50000}
    )
    assert response.status_code == 200
    assert response.json()["budget"]["current_balance"] == 50000

def test_place_bet_insufficient_funds():
    """Test bet rejection when funds insufficient."""
    # Initialize with 1000
    client.post("/api/budget/initialize", json={"initial_amount": 1000})
    
    # Try to bet 2000
    response = client.post(
        "/api/bets/place",
        json={"stake": 2000, "odds": 2.0}
    )
    assert response.status_code == 400
    assert "insufficient" in response.json()["detail"].lower()
```

### 3. Paper Trading Tests
```python
def test_paper_trading_open_close_position():
    """Test paper trading workflow."""
    # Open position
    response = client.post("/api/paper-trading/positions/open", json={
        "signal_id": "test_123",
        "match_id": "match_456",
        "strategy": "simple_odds_change",
        "side": "BACK",
        "odds": 2.0,
        "confidence": 0.75
    })
    assert response.status_code == 200
    
    # Close with win
    response = client.post("/api/paper-trading/positions/test_123/close", json={
        "outcome": "win",
        "exit_odds": 2.0
    })
    assert response.status_code == 200
    assert response.json()["result"]["profit_loss"] > 0
```


# ============================================================
# PHOENIX Backend API - Multi-stage Docker Build
# FastAPI + SQLAlchemy + Redis
# ============================================================

# Stage 1: Build dependencies
FROM python:3.11-slim AS builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# Stage 2: Production runtime
FROM python:3.11-slim AS runtime

WORKDIR /app

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 curl \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Copy application code (features/ is imported at start-up by backend/services)
COPY shared/ /app/shared/
COPY features/ /app/features/
COPY backend/ /app/backend/

# S91 read-only paper and data API. backend/routers/paper.py and data.py import, at import time, the paper trader's
# scorecard, review, ledger and bet model, the training market and gate helpers, the match filter and the result tools.
# Same modules the paper trader image copies (Dockerfile.scraper); the rest of scraper/, training/ and virtual_trading/
# is not needed by these routes, but the packages are copied whole, as in that image, so their imports resolve.
COPY scraper/__init__.py /app/scraper/__init__.py
COPY scraper/match_filter.py /app/scraper/match_filter.py
COPY strategy/ /app/strategy/
COPY training/ /app/training/
COPY virtual_trading/ /app/virtual_trading/
COPY scripts/paper_report.py /app/scripts/paper_report.py
COPY scripts/results_reconciliation.py /app/scripts/results_reconciliation.py
COPY scripts/set_result.py /app/scripts/set_result.py

# Create non-root user
RUN useradd --create-home phoenix
USER phoenix

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:8001/api/health || exit 1

EXPOSE 8001

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "2"]

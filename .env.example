# PHOENIX Environment Configuration
# Copy this to .env and fill in your values

# Database (TimescaleDB)
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_NAME=phoenix_betting
POSTGRES_USER=phoenix

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Scraper
SCRAPER_HEADLESS=true
SCRAPER_POLL_INTERVAL=3
SCRAPER_INTERNATIONAL_ONLY=true
SCRAPER_AUTO_APPROVE_MATCHES=false  # true = auto-approve ICC/International; false = manual approval for all

# RL Agent
RL_ALGORITHM=ppo
RL_LEARNING_RATE=0.0003
RL_TOTAL_TIMESTEPS=500000
RL_STARTING_BANKROLL=100000
RL_MIN_MATCHES_TO_TRAIN=10  # Minimum qualifying matches before training starts

# API
API_PORT=8001
API_AUTH_ENABLED=false
API_KEY=change_me_in_production

# Betfair (optional secondary source)
BETFAIR_APP_KEY=
BETFAIR_SESSION_TOKEN=
BETFAIR_ENABLED=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

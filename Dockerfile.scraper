# ============================================================
# PHOENIX Scraper - Multi-stage Docker Build
# Playwright + Chromium for LotusBook scraping
# ============================================================

# Stage 1: Build dependencies
FROM python:3.11-slim AS builder

WORKDIR /build

COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# Stage 2: Production runtime
FROM python:3.11-slim AS runtime

WORKDIR /app

# Install system dependencies for Playwright/Chromium
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 \
    libcups2 libdrm2 libdbus-1-3 libxkbcommon0 \
    libatspi2.0-0 libxcomposite1 libxdamage1 libxfixes3 \
    libxrandr2 libgbm1 libpango-1.0-0 libcairo2 libasound2 \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Install Playwright browsers to a shared path: the build runs as root, the scraper as `phoenix`
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN playwright install chromium && chmod -R a+rx /ms-playwright

# Copy application code (the scraper stores rows through backend.models; the watchdog is a script)
COPY shared/ /app/shared/
COPY scraper/ /app/scraper/
COPY features/ /app/features/
COPY backend/__init__.py /app/backend/__init__.py
COPY backend/models/ /app/backend/models/
COPY scripts/run_scraper_forever.py /app/scripts/run_scraper_forever.py
COPY scripts/data_quality_monitor.py /app/scripts/data_quality_monitor.py
COPY scripts/quarantine_ticks.py /app/scripts/quarantine_ticks.py

# Create non-root user; logs/ is bind-mounted from the host so heartbeats are visible there
RUN useradd --create-home phoenix && mkdir -p /app/logs && chown -R phoenix /app/logs
USER phoenix

# The watchdog runs `python -m scraper.manager` as a child and restarts it on crash or stall
# (no live tick stored for SCRAPER_STALL_MINUTES); Docker restarts the container if the watchdog dies.
CMD ["python", "scripts/run_scraper_forever.py"]

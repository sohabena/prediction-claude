POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=phoenix_betting
POSTGRES_USER=phoenix
POSTGRES_PASSWORD=your_secure_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Backend
API_PORT=8000

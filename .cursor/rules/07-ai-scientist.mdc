### Feature Engineering Pipeline
```python
class SignalFeatureEngineer:
    """Extract ML features from betting signals."""
    
    def transform(self, signal_data: pd.DataFrame) -> pd.DataFrame:
        features = signal_data.copy()
        
        # Momentum features
        features['odds_momentum'] = features.groupby('match_id')['odds'].pct_change()
        features['odds_volatility'] = features.groupby('match_id')['odds'].rolling(5).std()
        
        # Time features
        features['hour_of_day'] = pd.to_datetime(features['timestamp']).dt.hour
        features['day_of_week'] = pd.to_datetime(features['timestamp']).dt.dayofweek
        
        # Strategy encoding
        features = pd.get_dummies(features, columns=['strategy'])
        
        return features
```

## Model Training Standards

### Time-Series Cross-Validation
```python
from sklearn.model_selection import TimeSeriesSplit

# NEVER use random splits for time-series data
tscv = TimeSeriesSplit(n_splits=5)

for train_idx, val_idx in tscv.split(X):
    X_train, X_val = X.iloc[train_idx], X.iloc[val_idx]
    y_train, y_val = y.iloc[train_idx], y.iloc[val_idx]
    
    model.fit(X_train, y_train)
    y_pred = model.predict_proba(X_val)[:, 1]
    
    # Evaluate
    auc = roc_auc_score(y_val, y_pred)
    brier = brier_score_loss(y_val, y_pred)
```

### Probability Calibration
```python
from sklearn.calibration import CalibratedClassifierCV

# Ensure predicted probabilities match actual frequencies
calibrated = CalibratedClassifierCV(base_model, method='isotonic')
calibrated.fit(X_train, y_train)

# Check calibration
from sklearn.calibration import calibration_curve
prob_true, prob_pred = calibration_curve(y_test, calibrated.predict_proba(X_test)[:, 1])
```

### Betting-Specific Metrics
```python
def evaluate_betting_model(y_true, y_pred_proba, odds):
    """Evaluate model with betting metrics."""
    
    # Standard ML metrics
    auc = roc_auc_score(y_true, y_pred_proba)
    brier = brier_score_loss(y_true, y_pred_proba)
    
    # Betting metrics
    threshold = 0.55  # Minimum confidence to bet
    bet_mask = y_pred_proba >= threshold
    
    if bet_mask.sum() > 0:
        # Calculate ROI on bets above threshold
        wins = y_true[bet_mask]
        bet_odds = odds[bet_mask]
        
        profit = sum(wins * (bet_odds - 1)) - sum(~wins * 1)
        roi = profit / bet_mask.sum() * 100
    else:
        roi = 0
    
    return {
        'auc': auc,
        'brier': brier,
        'roi': roi,
        'num_bets': bet_mask.sum()
    }
```


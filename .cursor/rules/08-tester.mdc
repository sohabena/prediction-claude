## Critical Test Categories

### 1. RL Environment Tests
The environment is the foundation. If `step()` or `reset()` has a bug, all training is wasted.

```python
def test_environment_reset():
    """Environment reset returns valid observation."""
    env = CricketBettingEnv()
    obs, info = env.reset()
    assert obs.shape == (env.observation_size,)
    assert not np.any(np.isnan(obs))

def test_environment_step_hold():
    """HOLD action should not change bankroll."""
    env = CricketBettingEnv()
    obs, _ = env.reset()
    initial_bankroll = env.portfolio.balance
    obs, reward, done, _, info = env.step(0)  # HOLD
    assert env.portfolio.balance == initial_bankroll

def test_environment_step_bet():
    """Betting action should update portfolio."""
    env = CricketBettingEnv()
    obs, _ = env.reset()
    obs, reward, done, _, info = env.step(1)  # BACK_HOME_SM
    assert info.get('bet_placed') == True

def test_environment_no_nan_observations():
    """No NaN values in observations at any step."""
    env = CricketBettingEnv()
    obs, _ = env.reset()
    for _ in range(100):
        action = env.action_space.sample()
        obs, _, done, _, _ = env.step(action)
        assert not np.any(np.isnan(obs)), "NaN in observation!"
        if done:
            obs, _ = env.reset()

def test_check_env():
    """Environment passes SB3 validation."""
    from stable_baselines3.common.env_checker import check_env
    env = CricketBettingEnv()
    check_env(env)  # Raises if invalid
```

### 2. Reward Function Tests
The reward function is the most critical component. A single bug here corrupts all learning.

```python
def test_reward_profitable_bet():
    """Winning bet should give positive reward."""
    reward = compute_reward(action=1, step_info={
        'bet_settled': True,
        'profit_loss': 500,
        'bankroll': 100000,
    })
    assert reward > 0

def test_reward_losing_bet():
    """Losing bet should give negative reward."""
    reward = compute_reward(action=1, step_info={
        'bet_settled': True,
        'profit_loss': -1000,
        'bankroll': 100000,
    })
    assert reward < 0

def test_reward_hold_neutral():
    """HOLD should give near-zero reward."""
    reward = compute_reward(action=0, step_info={
        'odds_change': 0.001,
    })
    assert abs(reward) < 0.01

def test_reward_drawdown_penalty():
    """Large drawdown should heavily penalize."""
    reward_normal = compute_reward(action=0, step_info={
        'current_drawdown': 0.05,
    })
    reward_drawdown = compute_reward(action=0, step_info={
        'current_drawdown': 0.20,
    })
    assert reward_drawdown < reward_normal

def test_reward_overtrading_penalty():
    """Excessive trading should be penalized."""
    reward = compute_reward(action=1, step_info={
        'bets_last_hour': 25,
        'bet_settled': False,
    })
    assert reward < 0
```

### 3. Feature Pipeline Tests
Features feed the RL agent. Bad features = bad decisions.

```python
def test_feature_output_shape():
    """Feature pipeline returns correct shape."""
    features = pipeline.compute(match_id, event)
    assert features.shape == (74,)
    assert features.dtype == np.float32

def test_feature_no_nan():
    """No NaN values in computed features."""
    features = pipeline.compute(match_id, event)
    assert not np.any(np.isnan(features))

def test_feature_normalization():
    """Features are approximately normalized after warmup."""
    for event in training_events[:100]:
        pipeline.compute(match_id, event)
    
    features = pipeline.compute(match_id, test_event)
    assert np.abs(features.mean()) < 2.0
    assert features.std() < 5.0

def test_implied_probability_sums():
    """Implied probabilities should sum to > 1 (overround)."""
    features = compute_odds_features(event)
    ip_sum = features[6] + features[7] + features[8]  # ip_home + ip_away + ip_draw
    assert ip_sum > 1.0  # Bookmaker always has margin

def test_momentum_with_flat_odds():
    """Flat odds should produce zero momentum."""
    history = [make_event(back_home=2.0)] * 10
    features = compute_momentum_features(history)
    assert all(abs(f) < 0.01 for f in features[:6])  # velocities
```

### 4. Parser Tests
```python
def test_parse_live_match():
    """Parser correctly extracts live match data."""
    raw = load_fixture('lotusbook_live_match.json')
    events = parser.parse(raw)
    assert len(events) > 0
    assert events[0].is_live == True
    assert events[0].back_home > 1.0

def test_parse_validates_odds():
    """Parser rejects invalid odds."""
    raw = {'back_home': 0.5}  # Invalid: < 1.0
    result = parser.validate_event(make_event(**raw))
    assert result == False

def test_parse_handles_missing_draw():
    """Parser handles missing draw odds (T20 cricket)."""
    raw = load_fixture('lotusbook_t20_no_draw.json')
    events = parser.parse(raw)
    assert events[0].back_draw is None
```

### 5. Graduation Tests
```python
def test_graduation_all_criteria_met():
    """Agent graduates when all criteria met for 14 days."""
    evaluator = GraduationEvaluator()
    result = evaluator.evaluate(metrics={
        'win_rate': 0.57,
        'roi': 0.10,
        'sharpe_ratio': 1.8,
        'max_drawdown': 0.08,
        'profitable_days': 12,
        'bet_volume': 150,
    }, consecutive_days=14)
    assert result.ready == True

def test_graduation_fails_one_criterion():
    """Agent does not graduate if any criterion fails."""
    evaluator = GraduationEvaluator()
    result = evaluator.evaluate(metrics={
        'win_rate': 0.57,
        'roi': 0.10,
        'sharpe_ratio': 1.2,  # Below threshold (1.5)
        'max_drawdown': 0.08,
        'profitable_days': 12,
        'bet_volume': 150,
    }, consecutive_days=14)
    assert result.ready == False
```

### 6. Risk Manager Tests
```python
def test_risk_max_bet_size():
    """Risk manager caps bet at 5% of bankroll."""
    result = risk_manager.validate_bet(
        stake=10000, bankroll=100000
    )
    assert result.approved == False  # 10% > 5% limit

def test_risk_circuit_breaker():
    """Circuit breaker triggers after 5 consecutive losses."""
    for _ in range(5):
        risk_manager.record_loss()
    assert risk_manager.is_halted == True

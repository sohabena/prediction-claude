### 6. Quality Gate Tests
```python
def test_data_quality_gate_rejects_stale_data():
    """Test that stale data is rejected."""
    state = MatchState(match_id="test")
    state.last_update = datetime.utcnow() - timedelta(seconds=10)
    
    signal = create_mock_signal()
    gate = DataQualityGate()
    result = gate.evaluate(signal, state)
    
    assert result.passed is False
    assert "stale" in result.reason.lower()
```

## Frontend Component Tests

### SignalCard
```typescript
describe('SignalCard', () => {
    it('displays strategy name and confidence', () => {
        render(<SignalCard signal={mockSignal} />);
        
        expect(screen.getByText('PANIC REBOUND')).toBeInTheDocument();
        expect(screen.getByText('87%')).toBeInTheDocument();
    });
    
    it('shows green color for high confidence', () => {
        const highConfidence = { ...mockSignal, confidence: 0.9 };
        render(<SignalCard signal={highConfidence} />);
        
        expect(screen.getByTestId('confidence-badge')).toHaveClass('bg-green');
    });
    
    it('calls onPlaceBet when button clicked', () => {
        const mockOnPlaceBet = jest.fn();
        render(<SignalCard signal={mockSignal} onPlaceBet={mockOnPlaceBet} />);
        
        fireEvent.click(screen.getByText('Place Bet'));
        expect(mockOnPlaceBet).toHaveBeenCalledWith(mockSignal);
    });
});
```


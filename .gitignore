# ============================================================
# PHOENIX .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/
*.whl

# --- Virtual Environment ---
venv/
.venv/
env/
ENV/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Environment & Secrets ---
.env
.env.local
.env.production
*.pem
*.key
credentials.json

# --- Database ---
*.db
*.sqlite3

# --- ML Models (large files) ---
models/checkpoints/*.zip
models/best_model.zip
*.pkl
*.h5
*.onnx

# --- Logs ---
logs/
*.log
dead_letters.jsonl

# --- TensorBoard ---
runs/
tb_logs/

# --- Docker ---
docker-data/

# --- Node.js (frontend) ---
node_modules/
.next/
out/
frontend/.next/
frontend/node_modules/

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Testing ---
.coverage
htmlcov/
.pytest_cache/
coverage.xml

# --- Jupyter ---
.ipynb_checkpoints/

# --- Misc ---
*.bak
*.tmp
*.temp

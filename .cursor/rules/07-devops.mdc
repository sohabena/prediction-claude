```

## Docker Compose Configuration

```yaml
version: '3.8'

services:
  redis:
    image: redis:7-alpine
    ports: ["6379:6379"]
    volumes: [redis_data:/data]
    command: redis-server --appendonly yes
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
    restart: unless-stopped

  timescaledb:
    image: timescale/timescaledb:latest-pg15
    ports: ["5432:5432"]
    environment:
      POSTGRES_USER: phoenix
      POSTGRES_PASSWORD: ${DB_PASSWORD:-phoenixpassword}
      POSTGRES_DB: phoenix_betting
    volumes: [timescale_data:/var/lib/postgresql/data]
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U phoenix"]
      interval: 10s
    restart: unless-stopped

  backend:
    build: {context: ., dockerfile: Dockerfile.backend}
    ports: ["8000:8000"]
    environment:
      - REDIS_HOST=redis
      - DATABASE_URL=postgresql://phoenix:${DB_PASSWORD}@timescaledb:5432/phoenix_betting
    depends_on:
      redis: {condition: service_healthy}
      timescaledb: {condition: service_healthy}
    restart: unless-stopped

  scraper:
    build: {context: ., dockerfile: Dockerfile.scraper}
    environment:
      - REDIS_HOST=redis
      - BETTING_SITE_URL=${BETTING_SITE_URL}
      - SCRAPER_HEADLESS=true
    depends_on:
      redis: {condition: service_healthy}
    restart: unless-stopped

  rl-trainer:
    build: {context: ., dockerfile: Dockerfile.rl}
    environment:
      - REDIS_HOST=redis
      - DATABASE_URL=postgresql://phoenix:${DB_PASSWORD}@timescaledb:5432/phoenix_betting
      - RL_TRAINING_MODE=${RL_TRAINING_MODE:-offline}
    volumes:
      - ./models:/app/models
      - ./logs:/app/logs
    depends_on:
      redis: {condition: service_healthy}
      timescaledb: {condition: service_healthy}
    restart: unless-stopped

  frontend:
    build: {context: ./frontend, dockerfile: Dockerfile}
    ports: ["3000:3000"]
    environment:
      - NEXT_PUBLIC_API_URL=http://backend:8000
      - NEXT_PUBLIC_WS_URL=ws://backend:8000/ws
    depends_on: [backend]
    restart: unless-stopped
```


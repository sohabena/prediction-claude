## Agent Sanity Checks

Special tests for RL agent behavior:

```python
def test_agent_mostly_holds():
    """Trained agent should HOLD > 80% of the time."""
    actions = evaluate_agent(model, env, n_steps=1000)
    hold_pct = (actions == 0).mean()
    assert hold_pct > 0.80, f"Agent holds only {hold_pct:.0%}"

def test_agent_respects_risk_limits():
    """Agent should never exceed risk limits."""
    obs, _ = env.reset()
    for _ in range(500):
        action, _ = model.predict(obs)
        obs, _, done, _, info = env.step(action)
        assert info['exposure_pct'] <= 0.55  # 50% + buffer
        if done:
            obs, _ = env.reset()

def test_agent_no_degenerate_policy():
    """Agent should use more than one action type."""
    actions = evaluate_agent(model, env, n_steps=1000)
    unique_actions = np.unique(actions)
    assert len(unique_actions) >= 2, "Agent uses only one action"
```


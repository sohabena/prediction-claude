## Critical Test Categories

### 1. Model Zoo & Dynamic Routing Tests
Ensure each competition, format, and gender routes strictly to the correct specialist policy:

```python
def test_model_zoo_routing():
    """Verify routing across all 12 specialist categories."""
    assert resolve_specialist_key("IPL", "Chennai Super Kings vs MI", gender="male") == "ipl"
    assert resolve_specialist_key("Women's Big Bash League", "Sydney Sixers vs Stars", gender="female") == "wbbl_women"
    assert resolve_specialist_key("ICC Men's T20 World Cup", "India vs Pakistan", gender="male") == "t20i_men"
    assert resolve_specialist_key("ICC Women's T20 World Cup", "Australia vs England", gender="female") == "t20i_women"
```

### 2. RL Environment Tests
The environment is the foundation. If `step()` or `reset()` has a bug, all training is wasted.

```python
def test_environment_reset():
    """Environment reset returns valid 50-dimensional observation."""
    env = CricketBettingEnv()
    obs, info = env.reset()
    assert obs.shape == (50,)
    assert not np.any(np.isnan(obs))

def test_environment_step_hold():
    """HOLD action should not change bankroll."""
    env = CricketBettingEnv()
    obs, _ = env.reset()
    initial_bankroll = env.portfolio.balance
    obs, reward, done, _, info = env.step(0)  # HOLD
    assert env.portfolio.balance == initial_bankroll

def test_environment_step_bet():
    """Betting action should update portfolio."""
    env = CricketBettingEnv()
    obs, _ = env.reset()
    obs, reward, done, _, info = env.step(1)  # BACK_HOME_SM
    assert info.get('bet_placed') == True

def test_environment_no_nan_observations():
    """No NaN values in observations at any step."""
    env = CricketBettingEnv()
    obs, _ = env.reset()
    for _ in range(100):
        action = env.action_space.sample()
        obs, _, done, _, _ = env.step(action)
        assert not np.any(np.isnan(obs)), "NaN in observation!"
        if done:
            obs, _ = env.reset()
```

### 3. Reward Function Tests
The reward function is the most critical component. A single bug here corrupts all learning.

```python
def test_reward_profitable_bet():
    """Winning bet should give positive reward."""
    reward = compute_reward(action=1, step_info={
        'bet_settled': True,
        'profit_loss': 500,
        'bankroll': 100000,
    })
    assert reward > 0

def test_reward_greening_up_bonus():
    """Greening-up opposing positions should fire hedge bonus (+15.0)."""
    reward = compute_reward(action=5, step_info={
        'hedged': True,
        'locked_profit': 1200,
        'bankroll': 100000,
    })
    assert reward >= 15.0

def test_reward_drawdown_penalty():
    """Large drawdown should heavily penalize."""
    reward_normal = compute_reward(action=0, step_info={
        'current_drawdown': 0.05,
    })
    reward_drawdown = compute_reward(action=0, step_info={
        'current_drawdown': 0.20,
    })
    assert reward_drawdown < reward_normal
```


# ============================================================
# PHOENIX Environment Configuration
# Copy to .env and fill in your values: cp .env.example .env
# ============================================================

# --- Database (TimescaleDB) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=phoenix_betting
POSTGRES_USER=phoenix
POSTGRES_PASSWORD=phoenix_secure_2026

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Backend API ---
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_ENABLED=false
API_KEY=change_me_in_production

# --- Scraper ---
SCRAPER_BETTING_SITE_URL=https://lotusbook.site/cricket
SCRAPER_HEADLESS=true
SCRAPER_POLL_INTERVAL=3

# --- Cricbuzz Enricher ---
CRICBUZZ_POLL_INTERVAL=10

# --- RL Agent ---
RL_TRAINING_MODE=offline
RL_MODEL_PATH=models/best_model.zip
RL_STARTING_BANKROLL=100000
RL_GRADUATION_ENABLED=true
RL_LEARNING_RATE=0.0003
RL_TOTAL_TIMESTEPS=500000

# --- Monitoring ---
GRAFANA_PASSWORD=phoenixadmin

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

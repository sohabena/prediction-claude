# ============================================================
# PHOENIX .gitignore
# ============================================================

# --- Phoenix runtime ---
.phoenix_pids.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/
*.whl

# --- Virtual Environment ---
venv/
.venv/
env/
ENV/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Environment & Secrets ---
#.env
.env.local
.env.production
*.pem
*.key
credentials.json

# --- Database ---
*.db
*.sqlite3

# --- ML Models (large files) ---
models/checkpoints/*.zip
models/specialists/*.zip
models/best_model.zip
*.pkl
*.h5
*.onnx

# --- Logs ---
logs/
*.log
dead_letters.jsonl

# --- TensorBoard ---
runs/
tb_logs/

# --- Docker ---
docker-data/

# --- Node.js (frontend) ---
node_modules/
.next/
out/
frontend/.next/
frontend/node_modules/

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Testing ---
.coverage
htmlcov/
.pytest_cache/
coverage.xml

# --- Jupyter ---
.ipynb_checkpoints/

# --- Misc ---
*.bak
*.tmp
*.temp

# --- Large Data & Scratch ---
data/
scratch/
frontend/tsconfig.tsbuildinfo

# Replay ledgers are regenerated by scripts/replay_paper.py; summaries are kept
reports/replay/**/bets.csv
reports/paper/dashboard.html

# The UI Data page (the data/ rule above is for datasets)
!frontend/app/data/
!frontend/components/data/
reports/paper/exports/

# Historical odds reports: statistics from licensed or personal-use data (aussportsbetting terms: personal use only)
reports/historical_odds/

# Secrets: never tracked (2026-11-04)
.env
models/specialists/candidates/
